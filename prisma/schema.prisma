// One delivery per device and source occurrence; leases allow restart-safe retries.
model PushDelivery {
  id String @id @default(uuid()) @db.Uuid
  subscriptionId String @db.Uuid
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  notificationId String? @db.Uuid
  notification UserNotification? @relation(fields: [notificationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  generation Int @default(0)
  occurrenceKey String @db.VarChar(64)
  sourceKind String @db.VarChar(20)
  sourceId Int
  targetAt DateTime @db.Timestamptz(3)
  sendAt DateTime @db.Timestamptz(3)
  status String @default("PENDING") @db.VarChar(20)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(3)
  leaseUntil DateTime? @db.Timestamptz(3)
  errorCode String? @db.VarChar(30)
  sentAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([subscriptionId, occurrenceKey, generation])
  @@index([notificationId])
  @@index([status, nextAttemptAt, leaseUntil])
}

// A series owns the repeat rule; individual tasks/events keep their own history.
