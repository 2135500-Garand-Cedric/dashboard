  icon String @default("folder") @db.VarChar(20)
  revision Int @default(1)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  articles KnowledgeArticle[]
  @@unique([id, userId])
  @@index([userId, parentId])
}

model KnowledgeTemplate {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  name String @db.VarChar(160)
  normalizedName String @db.VarChar(160)
  body String
  type String @default("REFERENCE") @db.VarChar(30)
  revision Int @default(1)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([id, userId])
  @@unique([userId, normalizedName])
  @@index([userId, archivedAt])
}
model KnowledgeDraft {
  id String @id @db.Uuid
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  savedArticleId Int? @unique
  @@unique([savedArticleId, userId])
  savedArticle KnowledgeArticle? @relation(fields: [savedArticleId, userId], references: [id, userId], onDelete: Restrict, onUpdate: NoAction)
  discardedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  attachments WorkAttachment[]
  @@unique([id, userId])
  @@index([userId, updatedAt])
}

// Logical reminders are independent of device delivery and source completion.
model UserNotification {
  id String @id @default(uuid()) @db.Uuid
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  occurrenceKey String @db.VarChar(64)
  sourceKind String @db.VarChar(20)
  sourceId Int
  category String @db.VarChar(20)
  titleSnapshot String @db.VarChar(150)
  labelSnapshot String @db.VarChar(40)
  sourceDate String? @db.VarChar(10)
  targetAt DateTime @db.Timestamptz(3)
  dueAt DateTime @db.Timestamptz(3)
  lifecycle String @default("ACTIVE") @db.VarChar(20)
  retiredReason String? @db.VarChar(40)
  retiredAt DateTime? @db.Timestamptz(3)
  readAt DateTime? @db.Timestamptz(3)
  dismissedAt DateTime? @db.Timestamptz(3)
  snoozedUntil DateTime? @db.Timestamptz(3)
  generation Int @default(0)
  revision Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  deliveries PushDelivery[]
  @@unique([userId, occurrenceKey])
  @@index([userId, lifecycle, dueAt, id])
  @@index([userId, readAt, dismissedAt, snoozedUntil])
}

// Shared outbox. Prepared messages never contain API keys; access is server-only.
// Compact rows remain after message expiry so old jobs cannot be sent again.
model EmailDelivery {
  id String @id @default(uuid()) @db.Uuid
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind String @db.VarChar(50)
  dedupeKey String @db.VarChar(150)
  payload Json
  message Json?
  status String @default("PENDING") @db.VarChar(20)
  attempts Int @default(0)
  claimToken String? @db.Uuid
  leaseUntil DateTime? @db.Timestamptz(3)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(3)
  firstAttemptAt DateTime? @db.Timestamptz(3)
  sentAt DateTime? @db.Timestamptz(3)
  providerId String? @db.VarChar(100)
  errorCode String? @db.VarChar(40)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([userId, dedupeKey])
  @@index([userId, status, nextAttemptAt, leaseUntil])
}

// Owner consent and recipient are managed in the dashboard, never inferred from OAuth email.
model EmailSettings {
  userId Int @id
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  enabled Boolean @default(false)
  recipient String? @db.VarChar(254)
  revision Int @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}


model AuditEvent {
  actorUserId Int?
  id String @id @default(uuid()) @db.Uuid
  userId Int
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  actorKind String @db.VarChar(12)
  actorGithubId String? @db.VarChar(30)
  category String @db.VarChar(30)
  action String @db.VarChar(100)
  outcome String @db.VarChar(12)
  entityType String @db.VarChar(50)
  entityId String? @db.VarChar(128)
  entityReference String @db.VarChar(160)
  summary String @db.VarChar(300)
  changes Json
  operationKey String @db.VarChar(240)
  eventKey String @db.VarChar(240)
  originType String? @db.VarChar(50)
  originId String? @db.VarChar(128)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, eventKey])
  @@index([userId, occurredAt, id])
  @@index([userId, category, occurredAt, id])
  @@index([userId, entityType, entityId, occurredAt])
}

// Login identities are independent of financial accounts and directory contacts.
model AuthAccount {
  id String @id @default(uuid()) @db.Uuid
  userId Int
  provider String @db.VarChar(20)
  providerAccountId String @db.VarChar(200)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([provider,providerAccountId])
  @@unique([userId,provider])
}
model AuthSession {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  userId Int
  expires DateTime @db.Timestamptz(3)
  authenticatedAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,expires])
}
model UserPermission {
  userId Int
  capability String @db.VarChar(60)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([userId,capability])
}
model UserInvitation {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  label String @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expires DateTime @db.Timestamptz(3)
  usedAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  usedById Int? @unique
}
model AuthLinkIntent {
  tokenHash String @id @db.VarChar(64)
  userId Int
  sessionId String @db.Uuid
  provider String @db.VarChar(20)
  expires DateTime @db.Timestamptz(3)
}
model VocabularyPackVersion {
  id Int @id @default(autoincrement())
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  content Json
  wordCount Int
}
model JapaneseInitialization {
  userId Int @id
  choice String @db.VarChar(10)
  packVersionId Int?
  completedAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model AuthRequestBudget {
  key String @id @db.VarChar(100)
  count Int @default(1)
  expires DateTime @db.Timestamptz(3)
}
