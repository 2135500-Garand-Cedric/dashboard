generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TodoStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum ActivityVocabStatus {
  WEAK
  GOOD
  PERFECT
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  name      String?
  
  // Gamification
  totalXp    Int       @default(0)     // total XP accumulated
  coins     Int       @default(0)     // current coin balance
  
  // Relations
  todos     Todo[]
  events    Event[]
  userQuests UserQuest[]
  vocabulary Vocabulary[]
  financialAccounts FinancialAccount[]
  financeCategories FinanceCategory[]
  financialTransactions FinancialTransaction[]
  financialTransfers FinancialTransfer[]
  financialReceipts FinancialReceipt[]
  financialIncomeRecords FinancialIncomeRecord[]
  financialIncomeSources FinancialIncomeSource[]
  financialDeductionTypes FinancialDeductionType[]
  financialDocuments FinancialDocument[]
  financialImports FinancialImport[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Quest {
  id        Int      @id @default(autoincrement())
  title     String
  type      String   // "daily" or "weekly"
  xp        Int
  coins     Int

  userQuests UserQuest[]
}

model UserQuest {
  id           Int       @id @default(autoincrement())
  userId       Int
  questId      Int
  completed    Boolean   @default(false)
  lastCompleted DateTime?

  user  User  @relation(fields: [userId], references: [id])
  quest Quest @relation(fields: [questId], references: [id])

  @@unique([userId, questId])
}


model Todo {
  id           Int        @id @default(autoincrement())
  title        String
  description  String?    
  status       TodoStatus @default(TODO)
  priority     Int?

  // XP & coin rewards for completing this todo
  rewardXp     Int        @default(0)
  rewardCoins  Int        @default(0)

  // Relations
  userId       Int
  user         User       @relation(fields: [userId], references: [id])

  dependsOnId  Int?
  dependsOn    Todo?      @relation("TodoDependencies", fields: [dependsOnId], references: [id])
  blockedBy    Todo[]     @relation("TodoDependencies")
  
  subtasks     Subtask[]
  events       Event[] 

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Subtask {
  id        Int      @id @default(autoincrement())
  title     String
  done      Boolean  @default(false)
  todo      Todo     @relation(fields: [todoId], references: [id])
  todoId    Int
  createdAt DateTime @default(now())
}

model Event {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  date         DateTime?
  endDate      DateTime?
  completed    Boolean  @default(false)
  type         String?  // used for color/type (exam, personal, task...)
  
  // Relations
  linkedTodoId Int?
  linkedTodo   Todo?    @relation(fields: [linkedTodoId], references: [id])

  userId       Int
  user         User     @relation(fields: [userId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ActivityType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id       Int               @id @default(autoincrement())
  activity String

  activityVocab ActivityVocab[]
  practices     Practice[]
}

model ActivityVocab {
  id         Int                 @id @default(autoincrement())
  activityId Int

  vocabId    Int?
  verbFormId Int?

  status     ActivityVocabStatus @default(WEAK)

  activity Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  vocab    Vocabulary?  @relation(fields: [vocabId], references: [id], onDelete: Cascade)
  verbForm VerbForm?    @relation(fields: [verbFormId], references: [id], onDelete: Cascade)

  @@unique([activityId, vocabId])
  @@unique([activityId, verbFormId])
}

model Practice {
  id            Int         @id @default(autoincrement())
  activityId    Int
  date          DateTime    @default(now())
  wordCount     Int
  perfectCount  Int
  goodCount     Int
  weakCount     Int
  userId        Int         @default(1)
  sessionKey    String?     @unique
  activityName  String?
  startedAt     DateTime?
  completedAt   DateTime?
  durationSeconds Int?
  averageBefore Float?
  averageAfter  Float?
  selectedCategories Json?
  starredOnly   Boolean     @default(false)
  words         Json?

  activity   Activity @relation(fields: [activityId], references: [id])

  @@index([userId, date])
}


model Category {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  vocabulary Vocabulary[]
}

model Vocabulary {
  id            Int      @id @default(autoincrement())
  english       String
  japanese      String?
  hiragana      String
  userId        Int
  categoryId    Int?
  readHiragana  Boolean  @default(false)
  starred       Boolean  @default(false)
  addedDate     DateTime @default(now())
  lastPracticed DateTime?
  verbType      String?

  user     User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  activityVocab ActivityVocab[]
  verbForms VerbForm[]

  @@unique([english, hiragana, userId])
}

model VerbFormType {
  id        Int        @id @default(autoincrement())
  name      String     @unique  // e.g., "dictionary", "past", "negative", "polite"
  description String?           // optional: explain the form
  verbForms VerbForm[]
}

model VerbForm {
  id           Int        @id @default(autoincrement())
  baseVocabId  Int
  formTypeId   Int
  form         String      // e.g., 書いた, 書きます, 書かない
  reading      String

  baseVocab    Vocabulary @relation(fields: [baseVocabId], references: [id], onDelete: Cascade)
  formType     VerbFormType @relation(fields: [formTypeId], references: [id])
  activityVocab ActivityVocab[]

  @@unique([baseVocabId, formTypeId])
}

model JapaneseProgressSnapshot {
  id              Int      @id @default(autoincrement())
  userId          Int
  day             String
  average         Float
  vocabularyCount Int
  updatedAt       DateTime @updatedAt

  @@unique([userId, day])
}

enum FinancialAccountType {
  CHEQUING
  SAVINGS
  CREDIT_CARD
  CASH
  OTHER
}

enum FinanceCategoryType {
  INCOME
  EXPENSE
}

enum FinancialTransactionType {
  EXPENSE
  INCOME
  REFUND
  TRANSFER
  ADJUSTMENT
}

enum FinancialTransactionSource {
  MANUAL
  IMPORTED
}

enum FinancialDocumentType {
  RECEIPT
  BANK_STATEMENT
  CREDIT_CARD_STATEMENT
  PAY_STUB
  OTHER
}

model FinancialAccount {
  id               Int                  @id @default(autoincrement())
  userId           Int
  name             String               @db.VarChar(100)
  normalizedName   String               @db.VarChar(100)
  type             FinancialAccountType
  currency         String               @db.Char(3)
  maskedIdentifier String?              @db.VarChar(32)
  active           Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions     FinancialTransaction[]
  receipts         FinancialReceipt[]
  incomeRecords    FinancialIncomeRecord[]
  documents        FinancialDocument[]
  imports          FinancialImport[]

  @@unique([userId, normalizedName])
  @@index([userId, active])
}

model FinanceCategory {
  id             Int                 @id @default(autoincrement())
  userId         Int
  name           String              @db.VarChar(100)
  normalizedName String              @db.VarChar(100)
  type           FinanceCategoryType
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions   FinancialTransaction[]
  receipts       FinancialReceipt[]
  incomeRecords  FinancialIncomeRecord[]

  @@unique([userId, type, normalizedName])
  @@index([userId, active])
}

// Transactions are the canonical ledger. Signed amounts: inflow positive,
// outflow negative. Transfers/adjustments remain distinct from income/expenses.
model FinancialTransaction {
  id          Int                        @id @default(autoincrement())
  userId      Int
  accountId   Int
  categoryId  Int?
  occurredOn  DateTime                   @db.Date
  amount      Decimal                    @db.Decimal(19, 4)
  currency    String                     @db.Char(3)
  type        FinancialTransactionType
  source      FinancialTransactionSource @default(MANUAL)
  description String
  counterparty String?
  notes       String?
  transferId  String?                    @db.Uuid
  requestKey  String?                    @db.Uuid
  requestFingerprint String?             @db.VarChar(64)
  contentFingerprint String?             @db.VarChar(64)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  user        User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  account     FinancialAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category    FinanceCategory?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transfer    FinancialTransfer?         @relation(fields: [transferId], references: [id], onDelete: Cascade)
  receipts    FinancialReceipt[]
  incomeRecords FinancialIncomeRecord[]
  documents   FinancialDocument[]
  importEntries FinancialImportEntry[]

  @@index([userId, occurredOn])
  @@index([accountId, occurredOn])
  @@index([categoryId])
  @@unique([userId, requestKey])
  @@unique([transferId, accountId])
  @@index([userId, contentFingerprint])
}

// One economic transfer, with one outgoing and one incoming ledger entry.
// Both legs are created, edited, and deleted in the same database transaction.
model FinancialTransfer {
  id           String                 @id @default(uuid()) @db.Uuid
  userId       Int
  user         User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions FinancialTransaction[]

  @@index([userId])
}

model FinancialReceipt {
  id            Int                   @id @default(autoincrement())
  userId        Int
  accountId     Int?
  categoryId    Int?
  transactionId Int?
  purchasedOn   DateTime              @db.Date
  merchant      String?
  subtotal      Decimal               @default(0) @db.Decimal(19, 4)
  tax           Decimal               @default(0) @db.Decimal(19, 4)
  tip           Decimal               @default(0) @db.Decimal(19, 4)
  notes         String?
  requestKey    String?               @db.Uuid
  requestFingerprint String?          @db.VarChar(64)
  updatedAt     DateTime              @updatedAt
  total         Decimal               @db.Decimal(19, 4)
  currency      String                @db.Char(3)
  createdAt     DateTime              @default(now())
  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  account       FinancialAccount?     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category      FinanceCategory?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  documents     FinancialDocument[]

  @@index([userId, purchasedOn])
  @@index([accountId])
  @@index([categoryId])
  @@index([transactionId])
  @@unique([userId, requestKey])
}

model FinancialIncomeRecord {
  id            Int                   @id @default(autoincrement())
  userId        Int
  sourceId      Int?
  periodStart   DateTime?             @db.Date
  periodEnd     DateTime?             @db.Date
  notes         String?
  requestKey    String?               @db.Uuid
  requestFingerprint String?          @db.VarChar(64)
  updatedAt     DateTime              @updatedAt
  accountId     Int?
  categoryId    Int?
  transactionId Int?
  paidOn        DateTime              @db.Date
  description   String
  grossAmount   Decimal?              @db.Decimal(19, 4)
  netAmount     Decimal               @db.Decimal(19, 4)
  currency      String                @db.Char(3)
  createdAt     DateTime              @default(now())
  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  account       FinancialAccount?     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category      FinanceCategory?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  documents     FinancialDocument[]
  source        FinancialIncomeSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  deductions    FinancialIncomeDeduction[]

  @@index([userId, paidOn])
  @@index([accountId])
  @@index([categoryId])
  @@index([transactionId])
  @@index([sourceId])
  @@unique([userId, requestKey])
}

// Storage keys identify private objects, never publicly served file URLs.
model FinancialDocument {
  id            Int                   @id @default(autoincrement())
  userId        Int
  accountId     Int?
  transactionId Int?
  receiptId     Int?
  incomeRecordId Int?
  importId      Int?
  type          FinancialDocumentType
  contentHash   String?               @db.VarChar(64)
  storageKey    String                @unique
  originalName  String
  mimeType      String
  byteSize      Int
  createdAt     DateTime              @default(now())
  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  account       FinancialAccount?     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  receipt       FinancialReceipt?     @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  incomeRecord  FinancialIncomeRecord? @relation(fields: [incomeRecordId], references: [id], onDelete: SetNull)
  import        FinancialImport?      @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([accountId])
  @@index([transactionId])
  @@index([receiptId])
  @@unique([userId, contentHash])
  @@index([incomeRecordId])
  @@index([importId])
}

model FinancialImport {
  id          Int                  @id @default(autoincrement())
  userId      Int
  accountId   Int
  fingerprint String               @db.VarChar(64)
  createdAt   DateTime             @default(now())
  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  account     FinancialAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  entries     FinancialImportEntry[]
  documents   FinancialDocument[]

  @@unique([accountId, fingerprint])
  @@index([userId])
}

// Separate original source data from editable ledger fields. Many imported
// entries may match one transaction without duplicating that money movement.
model FinancialImportEntry {
  id            Int                   @id @default(autoincrement())
  importId      Int
  rowKey        String
  originalData  Json
  transactionId Int?
  import        FinancialImport       @relation(fields: [importId], references: [id], onDelete: Cascade)
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([importId, rowKey])
  @@index([transactionId])
}


// Source details and deduction labels are owner-managed; values remain on each pay record.
enum FinancialIncomeKind {
  EMPLOYMENT
  FREELANCE
  INTEREST
  GIFT
  REIMBURSEMENT
  OTHER
}

model FinancialIncomeSource {
  id             Int @id @default(autoincrement())
  userId         Int
  name           String
  normalizedName String
  kind           FinancialIncomeKind
  active         Boolean @default(true)
  user           User @relation(fields: [userId], references: [id], onDelete: Restrict)
  records        FinancialIncomeRecord[]

  @@unique([userId, normalizedName])
}

model FinancialDeductionType {
  id             Int @id @default(autoincrement())
  userId         Int
  name           String
  normalizedName String
  active         Boolean @default(true)
  user           User @relation(fields: [userId], references: [id], onDelete: Restrict)
  deductions     FinancialIncomeDeduction[]

  @@unique([userId, normalizedName])
}

model FinancialIncomeDeduction {
  id             Int @id @default(autoincrement())
  incomeRecordId Int
  typeId         Int
  amount         Decimal @db.Decimal(19, 4)
  incomeRecord   FinancialIncomeRecord @relation(fields: [incomeRecordId], references: [id], onDelete: Cascade)
  type           FinancialDeductionType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@unique([incomeRecordId, typeId])
  @@index([typeId])
}
