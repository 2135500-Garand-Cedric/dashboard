generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TodoStatus {
  NEW
  BACKLOG
  WAITING
  CANCELLED
  TODO
  IN_PROGRESS
  DONE
}

enum ActivityVocabStatus {
  WEAK
  GOOD
  PERFECT
}

model User {
  id        Int       @id @default(autoincrement())
  email     String?   @unique
  auditStartedAt DateTime @default(now()) @db.Timestamptz(3)
  auditEvents AuditEvent[]
  role String @default("MEMBER") @db.VarChar(10)
  active Boolean @default(true)
  emailVerified DateTime?
  lastSignedInAt DateTime? @db.Timestamptz(3)
  authAccounts AuthAccount[]
  authSessions AuthSession[]
  permissions UserPermission[]
  initialization JapaneseInitialization?
  japaneseCategories Category[]
  practices Practice[]
  progressSnapshots JapaneseProgressSnapshot[]
  name      String?
  timeZone  String? @db.VarChar(100)
  knowledgeTemplates KnowledgeTemplate[]
  knowledgeDrafts KnowledgeDraft[]
  knowledgeFolders KnowledgeFolder[]
  knowledgeArticles KnowledgeArticle[]
  knowledgeTags KnowledgeTag[]
  calendarHolidays CalendarHoliday[]
  calendarBirthdays CalendarBirthday[]
  holidaySelectionConfigured Boolean @default(false)
  // Previous calendar preferences are read once when upgrading to individual selections.
  holidayCountry String? @db.VarChar(2)
  holidayRegion String? @db.VarChar(10)
  holidayBanks Boolean @default(false)
  recurrenceSeries RecurrenceSeries[]
  
  // Gamification
  totalXp    Int       @default(0)     // total XP accumulated
  coins     Int       @default(0)     // current coin balance
  
  // Relations
  notificationSettings NotificationSettings?
  pushSubscriptions PushSubscription[]
  notifications UserNotification[]
  emailDeliveries EmailDelivery[]
  emailSettings EmailSettings?
  reimbursementPlans FinancialReimbursementPlan[]
  reimbursements FinancialReimbursement[]
  workFocus WorkFocus[]
  workProjects WorkProject[]
  workNotes WorkNote[]
  workAttachments WorkAttachment[]
  workContacts WorkContact[]
  workActivity WorkActivity[]
  workMutationReceipts WorkMutationReceipt[]
  todos     Todo[]
  events    Event[]
  userQuests UserQuest[]
  vocabulary Vocabulary[]
  financialAccountBalances FinancialAccountBalance[]
  financialIncomeSourceTypes FinancialIncomeSourceType[]
  financialAccounts FinancialAccount[]
  financeCategories FinanceCategory[]
  financialTransactions FinancialTransaction[]
  financialTransfers FinancialTransfer[]
  financialReceipts FinancialReceipt[]
  financialIncomeRecords FinancialIncomeRecord[]
  financialIncomeSources FinancialIncomeSource[]
  financialDeductionTypes FinancialDeductionType[]
  financialDocuments FinancialDocument[]
  financialImports FinancialImport[]
  financialMatches FinancialMatch[]
  financialMatchEvents FinancialMatchEvent[]
  financialExampleDataset FinancialExampleDataset?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Quest {
  id        Int      @id @default(autoincrement())
  title     String
  type      String   // "daily" or "weekly"
  xp        Int
  coins     Int

  userQuests UserQuest[]
}

model UserQuest {
  id           Int       @id @default(autoincrement())
  userId       Int
  questId      Int
  completed    Boolean   @default(false)
  lastCompleted DateTime?

  user  User  @relation(fields: [userId], references: [id])
  quest Quest @relation(fields: [questId], references: [id])

  @@unique([userId, questId])
}


model Todo {
  knowledgeLinks KnowledgeTaskLink[]
  occasionLinks CalendarOccasionTaskLink[]
  recurrenceId Int?
  recurrenceDate String? @db.VarChar(10)
  recurrence RecurrenceSeries? @relation(fields: [recurrenceId, userId], references: [id, userId], onDelete: Restrict, onUpdate: NoAction)
  @@unique([recurrenceId, recurrenceDate])
  id           Int        @id @default(autoincrement())
  title        String
  description  String?    
  status       TodoStatus @default(NEW)
  priorityLevel WorkPriority? @default(NORMAL)
  kind WorkTaskKind? @default(TASK)
  projectId Int?
  stageId Int?
  project WorkProject? @relation(fields: [projectId, userId], references: [id, userId], onDelete: Restrict, onUpdate: NoAction)
  stage WorkProjectStage? @relation(fields: [stageId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: NoAction)
  activityTypeId Int?
  activityType ActivityType? @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)
  system String?
  deadlineDate String? @db.VarChar(10)
  deadlineAt DateTime? @db.Timestamptz(3)
  deadlineTimeZone String? @db.VarChar(100)
  followUps WorkFollowUp[]
  keyDates WorkKeyDate[]
  desiredOutcome String?
  nextAction String?
  requesterId Int?
  requester WorkContact? @relation("TaskRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  affectedPeople TodoAffectedContact[]
  waitingOn String?
  waitingReason String?
  workaround String?
  completionSummary String?
  closureType WorkClosureType?
  completedAt DateTime?
  cancelledAt DateTime?
  archivedAt DateTime?
  notes WorkNote[]
  attachments WorkAttachment[]
  activity WorkActivity[]
  priority     Int?

  revision     Int        @default(1)

  // Relations
  userId       Int
  user         User       @relation(fields: [userId], references: [id])

  dependsOnId  Int?
  dependsOn    Todo?      @relation("TodoDependencies", fields: [dependsOnId], references: [id])
  blockedBy    Todo[]     @relation("TodoDependencies")
  
  parentId Int?
  parent Todo? @relation("TodoHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Todo[] @relation("TodoHierarchy")
  prerequisites TodoDependency[] @relation("DependencyDependent")
  blocking TodoDependency[] @relation("DependencyPrerequisite")
  relationsAsFirst TodoRelation[] @relation("RelationFirst")
  relationsAsSecond TodoRelation[] @relation("RelationSecond")

  subtasks     Subtask[]
  events       Event[]
  focusRecords WorkFocus[]
  calendarLinks EventTaskLink[]
  eventConversions WorkEventConversion[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([id, userId])
  @@index([projectId, stageId])
  @@index([userId, createdAt])
  @@index([dependsOnId])
  @@index([parentId])
  @@index([deadlineDate])
  @@index([deadlineAt])
  @@index([userId, archivedAt, status])
  @@index([activityTypeId])
  @@index([requesterId])
}

enum WorkPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum WorkTaskKind {
  TASK
  ISSUE
  REQUEST
  IMPROVEMENT
  MAINTENANCE
}

enum WorkClosureType {
  OUTCOME_ACHIEVED
  ACCEPTED_WORKAROUND
  CANCELLED
}


// Facts are appended by successful commands; there are no edit/delete activity APIs.
// Explicit task deletion may detach the FK, retaining its immutable reference/facts.
model WorkActivity {
  id Int @id @default(autoincrement())
  userId Int
  actorGithubId String
  todoId Int?
  projectId Int?
  project WorkProject? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  todoReference String?
  noteRevisionId Int?
  noteRevision WorkNoteRevision? @relation(fields: [noteRevisionId], references: [id], onDelete: Restrict)
  action String
  changes Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  todo Todo? @relation(fields: [todoId], references: [id], onDelete: SetNull)

  @@index([userId, todoId, createdAt])
  @@index([userId, todoReference, createdAt])
  @@index([userId, projectId, createdAt])
}

model Subtask {
  revision  Int      @default(1)
  id        Int      @id @default(autoincrement())
  title     String
  done      Boolean  @default(false)
  todo      Todo     @relation(fields: [todoId], references: [id])
  todoId    Int
  createdAt DateTime @default(now())
}

model Event {
  recurrenceException Boolean @default(false)
  recurrenceId Int?
  recurrenceDate String? @db.VarChar(10)
  recurrence RecurrenceSeries? @relation(fields: [recurrenceId, userId], references: [id, userId], onDelete: Restrict, onUpdate: NoAction)
  @@unique([recurrenceId, recurrenceDate])
  reminderMinutes Int?
  kind String @default("ORDINARY") @db.VarChar(30)
  timeZone String? @db.VarChar(100)
  allDayStart String? @db.VarChar(10)
  allDayEnd String? @db.VarChar(10)
  taskLinks EventTaskLink[]
  conversions WorkEventConversion[]
  workActivity WorkEventActivity[]
  revision     Int      @default(1)
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  date         DateTime?
  endDate      DateTime?
  completed    Boolean  @default(false)
  type         String?  // used for color/type (exam, personal, task...)
  
  // Relations
  linkedTodoId Int?
  linkedTodo   Todo?    @relation(fields: [linkedTodoId], references: [id])

  userId       Int
  user         User     @relation(fields: [userId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Technical replay protection, not a historical activity or reward payout ledger.
// No task/event FK: successful delete/create responses remain replayable.
model WorkMutationReceipt {
  id String @id @default(uuid()) @db.Uuid
  userId Int
  requestKey String @db.Uuid
  fingerprint String @db.VarChar(64)
  operation String
  result Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, requestKey])
}

model ActivityType {
  projects WorkProject[]
  tasks Todo[]
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id       Int               @id @default(autoincrement())
  activity String

  activityVocab ActivityVocab[]
  practices     Practice[]
}

model ActivityVocab {
  userId Int @default(dbgenerated())
  id         Int                 @id @default(autoincrement())
  activityId Int

  vocabId    Int?
  verbFormId Int?

  status     ActivityVocabStatus @default(WEAK)
  lastPracticed DateTime? @db.Timestamptz(3)

  activity Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  vocab    Vocabulary?  @relation(fields: [vocabId,userId], references: [id,userId], onDelete: Cascade, onUpdate:NoAction)
  verbForm VerbForm?    @relation(fields: [verbFormId,userId], references: [id,userId], onDelete: Cascade, onUpdate:NoAction)

  @@unique([activityId, vocabId])
  @@unique([activityId, verbFormId])
}

model Practice {
  id            Int         @id @default(autoincrement())
  activityId    Int
  date          DateTime    @default(now())
  wordCount     Int
  perfectCount  Int
  goodCount     Int
  weakCount     Int
  userId        Int
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  sessionKey    String?
  activityName  String?
  startedAt     DateTime?
  completedAt   DateTime?
  durationSeconds Int?
  xpEarned      Int?
  goldEarned    Int?
  averageBefore Float?
  averageAfter  Float?
  selectedCategories Json?
  starredOnly   Boolean     @default(false)
  words         Json?

  activity   Activity @relation(fields: [activityId], references: [id])

  @@index([userId, date])
  @@unique([userId,sessionKey])
}


model Category {
  isDefault Boolean @default(false)
  id         Int         @id @default(autoincrement())
  name       String
  normalizedName String
  kind String @default("OTHER") @db.VarChar(10)
  userId Int
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  vocabulary Vocabulary[]
  @@unique([userId,normalizedName])
  @@unique([id,userId])
}

model Vocabulary {
  id            Int      @id @default(autoincrement())
  english       String
  japanese      String?
  hiragana      String
  readings      String[] @default([])
  userId        Int
  categoryId    Int?
  readHiragana  Boolean  @default(false)
  starred       Boolean  @default(false)
  addedDate     DateTime @default(now())
  lastPracticed DateTime?
  verbType      String?

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?  @relation(fields: [categoryId,userId], references: [id,userId], onDelete: NoAction, onUpdate:NoAction)
  activityVocab ActivityVocab[]
  verbForms VerbForm[]

  @@unique([id,userId])
  @@unique([english, hiragana, userId])
}

model VerbFormType {
  id        Int        @id @default(autoincrement())
  name      String     @unique  // e.g., "dictionary", "past", "negative", "polite"
  description String?           // optional: explain the form
  verbForms VerbForm[]
}

model VerbForm {
  userId Int @default(dbgenerated())
  id           Int        @id @default(autoincrement())
  baseVocabId  Int
  formTypeId   Int
  form         String      // e.g., 書いた, 書きます, 書かない
  reading      String

  baseVocab    Vocabulary @relation(fields: [baseVocabId,userId], references: [id,userId], onDelete: Cascade, onUpdate:NoAction)
  formType     VerbFormType @relation(fields: [formTypeId], references: [id])
  activityVocab ActivityVocab[]

  @@unique([id,userId])
  @@unique([baseVocabId, formTypeId])
}

model JapaneseProgressSnapshot {
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  id              Int      @id @default(autoincrement())
  userId          Int
  day             String
  average         Float
  vocabularyCount Int
  updatedAt       DateTime @updatedAt

  @@unique([userId, day])
}

enum FinancialAccountType {
  CHEQUING
  SAVINGS
  CREDIT_CARD
  CASH
  OTHER
}

enum FinanceCategoryType {
  INCOME
  EXPENSE
}

enum FinancialTransactionType {
  EXPENSE
  INCOME
  REFUND
  TRANSFER
  ADJUSTMENT
}

enum FinancialTransactionSource {
  MANUAL
  IMPORTED
}

enum FinancialDocumentType {
  RECEIPT
  BANK_STATEMENT
  CREDIT_CARD_STATEMENT
  PAY_STUB
  OTHER
}

model FinancialAccount {
  id               Int                  @id @default(autoincrement())
  userId           Int
  name             String               @db.VarChar(100)
  normalizedName   String               @db.VarChar(100)
  balanceRevision  Int                  @default(0)
  type             FinancialAccountType
  currency         String               @db.Char(3)
  maskedIdentifier String?              @db.VarChar(32)
  active           Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  balances         FinancialAccountBalance[]
  transactions     FinancialTransaction[]
  receipts         FinancialReceipt[]
  incomeRecords    FinancialIncomeRecord[]
  documents        FinancialDocument[]
  imports          FinancialImport[]

  @@unique([userId, normalizedName])
  @@index([userId, active])
}

// Closing balance checkpoints are independent from income/expense movements.
model FinancialAccountBalance {
  id Int @id @default(autoincrement())
  userId Int
  accountId Int
  date DateTime @db.Date
  amount Decimal @db.Decimal(19, 4)
  ledgerAmount Decimal @db.Decimal(19, 4)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([accountId, date])
  @@index([userId, accountId, date])
}

model FinancialIncomeSourceType {
  id Int @id @default(autoincrement())
  userId Int
  name String @db.VarChar(100)
  normalizedName String @db.VarChar(100)
  legacyKind FinancialIncomeKind?
  active Boolean @default(true)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sources FinancialIncomeSource[]

  @@unique([userId, normalizedName])
  @@unique([userId, legacyKind])
}

model FinanceCategory {
  id             Int                 @id @default(autoincrement())
  userId         Int
  name           String              @db.VarChar(100)
  normalizedName String              @db.VarChar(100)
  type           FinanceCategoryType
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions   FinancialTransaction[]
  receipts       FinancialReceipt[]
  incomeRecords  FinancialIncomeRecord[]

  @@unique([userId, type, normalizedName])
  @@index([userId, active])
}

// Transactions are the canonical ledger. Signed amounts: inflow positive,
// outflow negative. Transfers/adjustments remain distinct from income/expenses.
// Counted movement = sign(amount) * (abs(amount) - excludedAmount).
// Confirmed duplicate allocations exclude amounts without deleting original facts.
model FinancialTransaction {
  id          Int                        @id @default(autoincrement())
  userId      Int
  accountId   Int
  categoryId  Int?
  occurredOn  DateTime                   @db.Date
  amount      Decimal                    @db.Decimal(19, 4)
  currency    String                     @db.Char(3)
  type        FinancialTransactionType
  source      FinancialTransactionSource @default(MANUAL)
  description String
  counterparty String?
  notes       String?
  transferId  String?                    @db.Uuid
  requestKey  String?                    @db.Uuid
  requestFingerprint String?             @db.VarChar(64)
  contentFingerprint String?             @db.VarChar(64)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  user        User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  account     FinancialAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category    FinanceCategory?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transfer    FinancialTransfer?         @relation(fields: [transferId], references: [id], onDelete: Cascade)
  receipts    FinancialReceipt[]
  incomeRecords FinancialIncomeRecord[]
  documents   FinancialDocument[]
  importEntries FinancialImportEntry[]
  excludedAmount Decimal @default(0) @db.Decimal(19, 4)
  matchSources FinancialMatch[] @relation("MatchSource")
  matchTargets FinancialMatch[] @relation("MatchTarget")
  reimbursementPlans FinancialReimbursementPlan[]
  reimbursementsReceived FinancialReimbursement[] @relation("ReimbursedExpense")
  reimbursementsPaid FinancialReimbursement[] @relation("ReimbursementPayment")

  @@index([userId, occurredOn])
  @@index([accountId, occurredOn])
  @@index([categoryId])
  @@unique([userId, requestKey])
  @@unique([transferId, accountId])
  @@index([userId, contentFingerprint])
}

// Tracking only: these links never create or exclude ledger movements.
model FinancialReimbursementPlan {
  id Int @id @default(autoincrement())
  expenseId Int
  userId Int
  person String @db.VarChar(120)
  contactId Int
  contact WorkContact @relation(fields: [contactId], references: [id], onDelete: Restrict)
  expectedAmount Decimal @db.Decimal(19, 4)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  expense FinancialTransaction @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  allocations FinancialReimbursement[]

  @@unique([expenseId, contactId])
  @@index([contactId])
  @@index([userId])
}

model FinancialReimbursement {
  id Int @id @default(autoincrement())
  userId Int
  expenseId Int
  paymentId Int
  planId Int
  amount Decimal @db.Decimal(19, 4)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  expense FinancialTransaction @relation("ReimbursedExpense", fields: [expenseId], references: [id], onDelete: Restrict)
  payment FinancialTransaction @relation("ReimbursementPayment", fields: [paymentId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan FinancialReimbursementPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([planId, paymentId])
  @@index([expenseId])
  @@index([userId, paymentId])
}

// One economic transfer, with one outgoing and one incoming ledger entry.
// Both legs are created, edited, and deleted in the same database transaction.
model FinancialTransfer {
  id           String                 @id @default(uuid()) @db.Uuid
  userId       Int
  user         User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions FinancialTransaction[]

  @@index([userId])
}

model FinancialReceipt {
  id            Int                   @id @default(autoincrement())
  userId        Int
  accountId     Int?
  categoryId    Int?
  transactionId Int?
  purchasedOn   DateTime              @db.Date
  merchant      String?
  subtotal      Decimal               @default(0) @db.Decimal(19, 4)
  tax           Decimal               @default(0) @db.Decimal(19, 4)
  tip           Decimal               @default(0) @db.Decimal(19, 4)
  notes         String?
  requestKey    String?               @db.Uuid
  requestFingerprint String?          @db.VarChar(64)
  updatedAt     DateTime              @updatedAt
  total         Decimal               @db.Decimal(19, 4)
  currency      String                @db.Char(3)
  createdAt     DateTime              @default(now())
  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  account       FinancialAccount?     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category      FinanceCategory?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  documents     FinancialDocument[]
  matches FinancialMatch[]

  @@index([userId, purchasedOn])
  @@index([accountId])
  @@index([categoryId])
  @@index([transactionId])
  @@unique([userId, requestKey])
}

model FinancialIncomeRecord {
  id            Int                   @id @default(autoincrement())
  userId        Int
  sourceId      Int?
  periodStart   DateTime?             @db.Date
  periodEnd     DateTime?             @db.Date
  notes         String?
  requestKey    String?               @db.Uuid
  requestFingerprint String?          @db.VarChar(64)
  updatedAt     DateTime              @updatedAt
  accountId     Int?
  categoryId    Int?
  transactionId Int?
  paidOn        DateTime              @db.Date
  description   String
  grossAmount   Decimal?              @db.Decimal(19, 4)
  netAmount     Decimal               @db.Decimal(19, 4)
  currency      String                @db.Char(3)
  createdAt     DateTime              @default(now())
  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  account       FinancialAccount?     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category      FinanceCategory?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  documents     FinancialDocument[]
  source        FinancialIncomeSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  deductions    FinancialIncomeDeduction[]
  matches FinancialMatch[]

  @@index([userId, paidOn])
  @@index([accountId])
  @@index([categoryId])
  @@index([transactionId])
  @@index([sourceId])
  @@unique([userId, requestKey])
}

// Storage keys identify private objects, never publicly served file URLs.
model FinancialDocument {
  id            Int                   @id @default(autoincrement())
  userId        Int
  accountId     Int?
  transactionId Int?
  receiptId     Int?
  incomeRecordId Int?
  importId      Int?
  type          FinancialDocumentType
  contentHash   String?               @db.VarChar(64)
  storageKey    String                @unique
  originalName  String
  mimeType      String
  byteSize      Int
  createdAt     DateTime              @default(now())
  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  account       FinancialAccount?     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  receipt       FinancialReceipt?     @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  incomeRecord  FinancialIncomeRecord? @relation(fields: [incomeRecordId], references: [id], onDelete: SetNull)
  import        FinancialImport?      @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([accountId])
  @@index([transactionId])
  @@index([receiptId])
  @@unique([userId, contentHash])
  @@index([incomeRecordId])
  @@index([importId])
}

model FinancialImport {
  periodStart DateTime? @db.Date
  periodEnd DateTime? @db.Date
  matchingOnly Boolean @default(false)
  id          Int                  @id @default(autoincrement())
  userId      Int
  accountId   Int
  status      FinancialImportStatus @default(DRAFT)
  revision    Int                  @default(1)
  originalName String?
  byteSize    Int?
  parsing     Json?
  headers     Json?
  mapping     Json?
  updatedAt   DateTime             @updatedAt
  completedAt DateTime?
  fingerprint String               @db.VarChar(64)
  createdAt   DateTime             @default(now())
  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  account     FinancialAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  entries     FinancialImportEntry[]
  documents   FinancialDocument[]

  @@unique([accountId, fingerprint])
  @@index([userId])
}

// Separate original source data from editable ledger fields. Many imported
// entries may match one transaction without duplicating that money movement.
model FinancialImportEntry {
  id            Int                   @id @default(autoincrement())
  importId      Int
  rowKey        String
  rowNumber     Int?
  rowFingerprint String? @db.VarChar(64)
  sourceIdentifier String?
  action        FinancialImportAction @default(REVIEW)
  normalized    Json?
  originalData  Json
  transactionId Int?
  import        FinancialImport       @relation(fields: [importId], references: [id], onDelete: Cascade)
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  matches FinancialMatch[]

  @@unique([importId, rowKey])
  @@index([transactionId])
  @@index([rowFingerprint])
  @@index([sourceIdentifier])
}


// Source details and deduction labels are owner-managed; values remain on each pay record.
enum FinancialIncomeKind {
  EMPLOYMENT
  FREELANCE
  INTEREST
  GIFT
  REIMBURSEMENT
  OTHER
}

model FinancialIncomeSource {
  id             Int @id @default(autoincrement())
  userId         Int
  name           String
  normalizedName String
  kind           FinancialIncomeKind
  typeId         Int?
  type           FinancialIncomeSourceType? @relation(fields: [typeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  active         Boolean @default(true)
  user           User @relation(fields: [userId], references: [id], onDelete: Restrict)
  records        FinancialIncomeRecord[]

  @@unique([userId, normalizedName])
  @@index([typeId])
}

model FinancialDeductionType {
  id             Int @id @default(autoincrement())
  userId         Int
  name           String
  normalizedName String
  active         Boolean @default(true)
  user           User @relation(fields: [userId], references: [id], onDelete: Restrict)
  deductions     FinancialIncomeDeduction[]

  @@unique([userId, normalizedName])
}

model FinancialIncomeDeduction {
  id             Int @id @default(autoincrement())
  incomeRecordId Int
  typeId         Int
  amount         Decimal @db.Decimal(19, 4)
  incomeRecord   FinancialIncomeRecord @relation(fields: [incomeRecordId], references: [id], onDelete: Cascade)
  type           FinancialDeductionType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@unique([incomeRecordId, typeId])
  @@index([typeId])
}

enum FinancialImportStatus {
  DRAFT
  COMPLETED
}
enum FinancialImportAction {
  REVIEW
  CREATE
  MATCH
  SKIP
}

enum FinancialMatchKind {
  RECEIPT
  INCOME
  DUPLICATE
  REFUND
  STATEMENT
}

enum FinancialMatchStatus {
  CONFIRMED
  REJECTED
  UNLINKED
}

// Suggestions are computed, never treated as confirmed allocations.
model FinancialMatch {
  id                  Int                    @id @default(autoincrement())
  userId              Int
  kind                FinancialMatchKind
  pairKey             String
  receiptId           Int?
  incomeRecordId      Int?
  sourceTransactionId Int?
  importEntryId       Int?
  transactionId       Int?
  amount              Decimal                @db.Decimal(19, 4)
  currency            String                 @db.Char(3)
  status              FinancialMatchStatus
  revision            Int                    @default(1)
  note                String?
  sourceSnapshot      Json
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  user                User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  receipt             FinancialReceipt?      @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  incomeRecord        FinancialIncomeRecord? @relation(fields: [incomeRecordId], references: [id], onDelete: SetNull)
  sourceTransaction   FinancialTransaction?  @relation("MatchSource", fields: [sourceTransactionId], references: [id], onDelete: SetNull)
  transaction         FinancialTransaction?  @relation("MatchTarget", fields: [transactionId], references: [id], onDelete: SetNull)
  importEntry         FinancialImportEntry?  @relation(fields: [importEntryId], references: [id], onDelete: SetNull)
  events              FinancialMatchEvent[]

  @@unique([userId, pairKey])
  @@index([userId, status, kind])
  @@index([receiptId, status])
  @@index([incomeRecordId, status])
  @@index([sourceTransactionId, status])
  @@index([transactionId, status])
  @@index([importEntryId, status])
}

// Append-only snapshots survive unlinking and deletion of original supporting records.
model FinancialMatchEvent {
  id                 Int            @id @default(autoincrement())
  userId             Int
  matchId            Int
  requestKey         String         @db.Uuid
  requestFingerprint String
  action             String
  details            Json
  createdAt          DateTime       @default(now())
  user               User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  match              FinancialMatch @relation(fields: [matchId], references: [id], onDelete: Restrict)

  @@unique([userId, requestKey])
  @@index([userId, createdAt])
  @@index([matchId])
}

// Development examples are identified explicitly, so reports can exclude them.
model FinancialExampleDataset {
  userId Int @id
  version Int
  manifest Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}


