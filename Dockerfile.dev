FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci --no-audit --no-fund \
    && sha256sum package.json package-lock.json | sha256sum | cut -d ' ' -f 1 > node_modules/.dashboard-dependency-hash

COPY prisma ./prisma
RUN npx prisma generate

COPY . .

COPY scripts/dev-entrypoint.sh /usr/local/bin/dashboard-dev-entrypoint
RUN chmod +x /usr/local/bin/dashboard-dev-entrypoint

ENTRYPOINT ["dashboard-dev-entrypoint"]

EXPOSE 3000

CMD ["npm", "run", "dev"]
