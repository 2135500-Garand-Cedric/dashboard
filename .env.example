# Production website and notification worker (lowercase GHCR repository).
# Prefer a full commit SHA tag for a repeatable deployment.
DASHBOARD_IMAGE=ghcr.io/2135500-garand-cedric/dashboard:latest

# PostgreSQL Database Config
POSTGRES_USER=xxx
POSTGRES_PASSWORD=xxx
POSTGRES_DB=xxx

# PostgreSQL Container Config
POSTGRES_HOST=xxx
POSTGRES_PORT=xxx

# Prisma Connection URL
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# API KEYS
YOUTUBE_API_KEY=xxx
TIME_MANAGER_API_KEY=xxx

# Next Auth
NEXTAUTH_URL=xxx
NEXTAUTH_SECRET=xxx
GITHUB_CLIENT_ID=xxx
GITHUB_CLIENT_SECRET=xxx


# Work date meaning, independent of browser/server locale.
APP_TIME_ZONE=America/Toronto

# Web Push: same stable keys in the dashboard and notification-worker.
# Generate once with: npm run notifications:keys
PUSH_ENABLED=false
# Development Compose requires its own explicit opt-in.
DEV_PUSH_ENABLED=false
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:you@example.com
# NEXTAUTH_URL above must be your public HTTPS dashboard URL for iPhone.
